FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Instalar Ansible, OpenSSH client, sshpass y Python
RUN apt-get update && apt-get install -y \
    ansible \
    openssh-client \
    sshpass \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ansible

CMD ["ansible-playbook", "playbook.yml"]
